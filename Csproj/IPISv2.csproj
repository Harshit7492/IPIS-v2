<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.8</FileVersion>
    <Version>1.0.0</Version>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.4" />
    <PackageReference Include="MaterialSkin.2" Version="2.3.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Native pdfium (x64 only). ExcludeAssets="build" stops the package's .props from
         copying pdfium.dll into an "x64\" subfolder; it is copied next to the exe below. -->
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" ExcludeAssets="build" GeneratePathProperty="true" />
    <PackageReference Include="PdfiumViewer.Updated" Version="2.14.5" />
    <PackageReference Include="ReportViewerCore.WinForms" Version="15.1.33" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup> 
  <ItemGroup>
    <ProjectReference Include="..\DataBaseHandler\DataBaseHandler.csproj" />
    <ProjectReference Include="..\Global_Data\Global_Data.csproj" />
    <ProjectReference Include="..\Helper\Helper.csproj" />
    <ProjectReference Include="..\LogManager\LogManager.csproj" />
    <ProjectReference Include="..\PacketGeneration\PacketGeneration.csproj" /> 
    <Content Include="images\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Docs\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Report\TrainReports\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Remove="Report\ReportDataSets\TrainLogReportDataSet.Designer.cs" />
    <Content Remove="Report\TrainReports\TrainLogReport.rdlc" />
    <None Remove="Report\ReportDataSets\TrainLogReportDataSet.xsc" />
    <None Remove="Report\ReportDataSets\TrainLogReportDataSet.xsd" />
    <None Remove="Report\ReportDataSets\TrainLogReportDataSet.xss" />
    <None Remove="Report\TrainReports\TrainLogReport.rdlc" />
 
    <Content Include="MyHelp2.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Video converter used by ucVDC (.wmv / .dat / .wam -> .mp4) -->
    <Content Include="ffmpeg\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- pdfium.dll goes in the app folder (no x64\/x86\ subfolders) -->
    <Content Include="$(PkgPdfiumViewer_Native_x86_64_v8-xfa)\Build\x64\pdfium.dll">
      <Link>pdfium.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Report\ReportDataSets\AnnouncementLogReportDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AnnouncementLogReportDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="Report\ReportDataSets\CGDBLogReportDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CGDBLogReportDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="Report\ReportDataSets\LEDMatrixFaultReportDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>LEDMatrixFaultReportDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="Report\ReportDataSets\LogTrainMasterDataset.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>LogTrainMasterDataset.xsd</DependentUpon>
    </Compile>
    <Compile Update="Report\ReportDataSets\TADBLogReportDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TADBLogReportDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="Report\ReportDataSets\TrainDetailsReportDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TrainDetailsReportDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="Report\ReportDataSets\UserLogInReportDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>UserLogInReportDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="Report\ReportDataSets\VDCLogReportDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>VDCLogReportDataSet.xsd</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Report\ReportDataSets\AnnouncementLogReportDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>AnnouncementLogReportDataSet.Designer.cs</LastGenOutput>
      <CustomToolNamespace>IPISv2.ReportDataSets</CustomToolNamespace>
    </None>
    <None Update="Report\ReportDataSets\CGDBLogReportDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>CGDBLogReportDataSet.Designer.cs</LastGenOutput>
      <CustomToolNamespace>IPISv2.ReportDataSets</CustomToolNamespace>
    </None>
    <None Update="Report\ReportDataSets\LEDMatrixFaultReportDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>LEDMatrixFaultReportDataSet.Designer.cs</LastGenOutput>
    </None>
    <None Update="Report\ReportDataSets\LogTrainMasterDataset.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>LogTrainMasterDataset.Designer.cs</LastGenOutput>
      <CustomToolNamespace>IPISv2.ReportDataSets</CustomToolNamespace>
    </None>
    <None Update="Report\ReportDataSets\TADBLogReportDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>TADBLogReportDataSet.Designer.cs</LastGenOutput>
      <CustomToolNamespace>IPISv2.ReportDataSets</CustomToolNamespace>
    </None>
    <None Update="Report\ReportDataSets\TrainDetailsReportDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>TrainDetailsReportDataSet.Designer.cs</LastGenOutput>
      <CustomToolNamespace>IPISv2.ReportDataSets</CustomToolNamespace>
    </None>
    <None Update="Report\ReportDataSets\UserLogInReportDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>UserLogInReportDataSet.Designer.cs</LastGenOutput>
      <CustomToolNamespace>IPISv2.ReportDataSets</CustomToolNamespace>
    </None>
    <None Update="Report\ReportDataSets\VDCLogReportDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>VDCLogReportDataSet.Designer.cs</LastGenOutput>
      <CustomToolNamespace>IPISv2.ReportDataSets</CustomToolNamespace>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AxInterop.WMPLib">
      <HintPath>libs\AxInterop.WMPLib.dll</HintPath>
    </Reference>
    <Reference Include="Interop.WMPLib">
      <HintPath>libs\Interop.WMPLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>