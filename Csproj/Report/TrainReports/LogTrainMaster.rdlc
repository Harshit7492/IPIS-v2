																<FontSize>8pt</FontSize>
																<FontWeight>SemiBold</FontWeight>
																<Color>#334155</Color>
															</Style>
														</TextRun>
													</TextRuns>
													<Style>
														<TextAlign>Center</TextAlign>
													</Style>
