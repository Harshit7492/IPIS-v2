												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>TRAIN NAME</Value>
															<Style>
																<FontFamily>Segoe UI</FontFamily>
																<FontSize>8pt</FontSize>
																<FontWeight>Bold</FontWeight>
																<Color>#FFFFFF</Color>
															</Style>
														</TextRun>
													</TextRuns>
													<Style>
														<TextAlign>Left</TextAlign>
													</Style>
												</Paragraph>
											</Paragraphs>
											<Style>
												<Border>
													<Color>#9CA3AF</Color>
													<Style>Solid</Style>
												</Border>
												<BackgroundColor>#1E3A8A</BackgroundColor>
												<VerticalAlign>Middle</VerticalAlign>
												<PaddingLeft>6pt</PaddingLeft>
												<PaddingRight>4pt</PaddingRight>
											</Style>
										</Textbox>
									</CellContents>
