<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
	<Body>
		<ReportItems>
			<!-- Data Table - Train Master Log Report -->
			<Tablix Name="Tablix1">
				<TablixBody>
					<TablixColumns>
						<!-- 1. LOG DATE -->
						<TablixColumn>
							<Width>1.2in</Width>
						</TablixColumn>
						<!-- 2. TRAIN NO -->
						<TablixColumn>
							<Width>0.8in</Width>
						</TablixColumn>
						<!-- 3. TRAIN NAME -->
						<TablixColumn>
							<Width>2.0in</Width>
						</TablixColumn>
						<!-- 4. DESTINATION -->
						<TablixColumn>
							<Width>0.8in</Width>
						</TablixColumn>
						<!-- 5. ARR TIME -->
						<TablixColumn>
							<Width>0.75in</Width>
						</TablixColumn>
						<!-- 6. DEP TIME -->
						<TablixColumn>
							<Width>0.75in</Width>
						</TablixColumn>
						<!-- 7. PF -->
						<TablixColumn>
							<Width>0.5in</Width>
						</TablixColumn>
						<!-- 8. RUNNING DAYS -->
						<TablixColumn>
							<Width>1.0in</Width>
						</TablixColumn>
						<!-- 9. TRAIN TYPE -->
						<TablixColumn>
							<Width>0.9in</Width>
						</TablixColumn>
						<!-- 10. CATEGORY -->
						<TablixColumn>
							<Width>0.9in</Width>
						</TablixColumn>
						<!-- 11. STATUS -->
						<TablixColumn>
							<Width>0.6in</Width>
						</TablixColumn>
					</TablixColumns>
					<TablixRows>
