												</Paragraph>
											</Paragraphs>
											<Style>
												<Border>
													<Color>#9CA3AF</Color>
													<Style>Solid</Style>
												</Border>
												<BackgroundColor>#1E3A8A</BackgroundColor>
												<VerticalAlign>Middle</VerticalAlign>
												<PaddingLeft>4pt</PaddingLeft>
												<PaddingRight>4pt</PaddingRight>
											</Style>
										</Textbox>
									</CellContents>
